# ─────────────────────────────────────────────────────────────
# Art For Soul — environment variables
# Copy this file to ".env" (and add the same keys in Vercel → Settings → Environment Variables)
# ─────────────────────────────────────────────────────────────

# Public contact links (already in use)
NEXT_PUBLIC_WHATSAPP="+919834040231"
NEXT_PUBLIC_INSTAGRAM="https://www.instagram.com/artforsoul.in"

# ── Database (Supabase Postgres) ──
# Supabase → Project → Connect → ORMs/Prisma. Use the POOLED url for DATABASE_URL
# (port 6543, ?pgbouncer=true) and the DIRECT url for DIRECT_URL (port 5432).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ── Customer accounts (custom email + password auth) ──
# A long random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-32-chars-or-more"

# ── Studio admin login (/admin) ──
# Defaults below are used if these are not set. CHANGE THE PASSWORD before launch.
ADMIN_EMAIL="admin@artforsoul.in"
ADMIN_PASSWORD="ArtForSoul@2025"

# ── Razorpay (payments) ──
# Hosted payment link / QR used in TEST mode (no API keys needed):
NEXT_PUBLIC_RAZORPAY_PAYMENT_LINK="https://rzp.io/rzp/MeCfWcy"
#
# ✅ AUTO-CONFIRM PAYMENTS — add your Razorpay API keys (TEST first: rzp_test_…).
# razorpay.com → Settings → API Keys → Generate Keys.
# With these set, "Book & Pay" opens Razorpay Checkout (cards / UPI / QR) and
# the payment is cryptographically verified, so bookings auto-confirm — no
# guessing, no false "paid", no manual step.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook backup (recommended) — Razorpay Dashboard → Settings → Webhooks
#   URL: https://artforsoul.in/api/webhooks/razorpay
#   Events: payment.captured, order.paid
#   Secret: paste the same value here
RAZORPAY_WEBHOOK_SECRET=""

# ── Email notifications (Gmail SMTP) ──
# When a payment is completed, an email is sent to NOTIFY_EMAILS with the
# service + client details. SMTP_PASS must be a Gmail "App Password"
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER="artforsoul.in@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
# Optional overrides:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
NOTIFY_EMAILS="artforsoul.in@gmail.com,nmartstudioz@gmail.com"

# Direct UPI QR (real, scannable — pays straight to this UPI ID)
NEXT_PUBLIC_UPI_ID="yourname@okhdfc"
NEXT_PUBLIC_UPI_NAME="Art For Soul"
